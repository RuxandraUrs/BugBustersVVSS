<Window x:Class="FitnessApp.WpfUI.Views.UserProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessApp.WpfUI.Views"
        xmlns:vm="clr-namespace:FitnessApp.WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="UserProfile" Height="450" Width="800">
    <Grid Background="#FF2D2D2D">
        <Label Content="{Binding WelcomeMessage}" HorizontalAlignment="Center" Margin="0,61,0,0" VerticalAlignment="Top" Height="72" Width="608" FontWeight="Bold" Foreground="#FF7DFFD8" FontSize="48" FontFamily="Bahnschrift" HorizontalContentAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Margin="58,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Language="en-ca" Text="BMI"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="687,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Text="B"/><Run Language="en-ca" Text="MR"/></TextBlock>
        <TextBlock Text="{Binding UserBMI}" HorizontalAlignment="Left" Height="23" Margin="37,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding UserBMR}" HorizontalAlignment="Left" Height="23" Margin="670,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>

    </Grid>
</Window>
