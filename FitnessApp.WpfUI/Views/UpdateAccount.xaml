<Window x:Class="FitnessApp.WpfUI.Views.UpdateAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessApp.WpfUI.Views"
        xmlns:vm="clr-namespace:FitnessApp.WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="UpdateAccount" Height="605" Width="800">
    <Grid Background="#FF2D2D2D">
        <Label x:Name="UsernameLabel" Content="Username :" HorizontalAlignment="Left" Margin="223,170,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="EmailLabel" Content="Email :" HorizontalAlignment="Left" Margin="269,235,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="HeightLabel" Content="Height :" HorizontalAlignment="Left" Margin="258,293,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="CurrentWeightLabel" Content="Current Weight :" HorizontalAlignment="Left" Margin="174,343,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="TargetWeightLabel" Content="Target Weight :" HorizontalAlignment="Left" Margin="188,393,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="TargetCalLabel" Content="Daily Calories Intake :" HorizontalAlignment="Left" Margin="119,443,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" HorizontalAlignment="Left" Margin="368,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Email}" HorizontalAlignment="Left" Margin="368,237,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding HeightCm}" HorizontalAlignment="Left" Margin="368,295,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding WeightKg}" HorizontalAlignment="Left" Margin="368,345,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding TargetWeightKg}" HorizontalAlignment="Left" Margin="368,395,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding DailyCalorieGoal}" HorizontalAlignment="Left" Margin="368,445,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <Button Command="{Binding UpdateAccountCommand}" Content="Update Account" HorizontalAlignment="Left" Margin="178,518,0,0" VerticalAlignment="Top" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Button Command="{Binding CancelCommand}" Content="Cancel" HorizontalAlignment="Left" Margin="458,518,0,0" VerticalAlignment="Top" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Label x:Name="Label" Content="Create your user account" HorizontalAlignment="Left" Margin="211,62,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="36" FontFamily="Bahnschrift" FontWeight="Bold"/>
    </Grid>
</Window>
