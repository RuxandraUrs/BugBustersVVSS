<Window x:Class="FitnessApp.WpfUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessApp.WpfUI"
        xmlns:vm="clr-namespace:FitnessApp.WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="460" Width="800">

    <Grid Background="#FF2D2D2D">
        <Label Content="Fitness App" HorizontalAlignment="Left" Margin="268,74,0,0" VerticalAlignment="Top" Height="72" Width="264" FontWeight="Bold" Foreground="#FF7DFFD8" FontSize="48" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="267,196,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="387" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="268,272,0,0" Width="387" Background="#FFA5FFE4" FontSize="22" FontFamily="Bahnschrift" PasswordChanged="PasswordBox_PasswordChanged" Height="34" VerticalAlignment="Top"/>
        <Label x:Name="UsernameLabel" Content="User :" HorizontalAlignment="Left" Margin="188,195,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="PasswordLabel" Content="Password :" HorizontalAlignment="Left" Margin="138,272,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Button Command="{Binding SignInCommand}" Content="Sign In" HorizontalAlignment="Left" Margin="294,354,0,0" VerticalAlignment="Top" FontSize="24" Height="41" Width="106" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Button Command="{Binding ExitCommand}" Content="Exit" HorizontalAlignment="Left" Margin="501,354,0,0" VerticalAlignment="Top" FontSize="24" Height="41" Width="104" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Menu Background="#FFA5FFE4" Height="20" VerticalAlignment="Top">
            <MenuItem Header="Account" Height="20" Background="Black" Foreground="#FF7DFFD8" FontFamily="Bahnschrift">
                <MenuItem Header="Create Account" Foreground="Black"
                          Command="{Binding Path=OpenSignUpPageCommand}"/>
            </MenuItem>
            <MenuItem Header="Misc" Height="20" Background="Black" Foreground="#FF7DFFD8" FontFamily="Bahnschrift">
                <MenuItem Header="About" Foreground="Black"
                          Command="{Binding Path=AboutCommand}"/>
            </MenuItem>
        </Menu>

    </Grid>
</Window>
