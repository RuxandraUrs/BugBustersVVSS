<Window x:Class="FitnessApp.WpfUI.Views.UserProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessApp.WpfUI.Views"
        xmlns:vm="clr-namespace:FitnessApp.WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="UserProfile" Height="450" Width="800">
    <Grid Background="#FF2D2D2D">
        <Label Content="{Binding WelcomeMessage}" HorizontalAlignment="Center" Margin="0,61,0,0" VerticalAlignment="Top" Height="72" Width="608" FontWeight="Bold" Foreground="#FF7DFFD8" FontSize="48" FontFamily="Bahnschrift" HorizontalContentAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Margin="232,261,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Language="en-ca" Text="BMI"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="351,261,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Text="B"/><Run Language="en-ca" Text="MR"/></TextBlock>
        <TextBlock Text="{Binding UserBMI}" HorizontalAlignment="Left" Height="23" Margin="211,290,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding UserBMR}" HorizontalAlignment="Left" Height="23" Margin="334,290,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="443,261,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Language="en-ca" Text="BMI Category"/></TextBlock>
        <TextBlock Text="{Binding BMICategory}" HorizontalAlignment="Left" Height="23" Margin="465,290,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="62,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20"><Run Language="en-ca" Text="Height (cm)"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="238,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20" Width="181" Height="24"><Run Language="en-ca" Text="Current Weight (kg)"/><LineBreak/><Run Language="en-ca"/><Run Text="(cm)"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="449,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20" Width="181" Height="24"><Run Language="en-ca" Text="Target"/><Run Text=" Weight (kg)"/><LineBreak/><Run/><Run Text="(cm)"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="682,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Bahnschrift" Foreground="#FF7DFFD8" FontWeight="Bold" FontSize="20" Width="38" Height="24"><Run Language="en-ca" Text="Age"/></TextBlock>
        <TextBlock Text="{Binding Height}" HorizontalAlignment="Left" Height="23" Margin="76,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding CurrentWeight}" HorizontalAlignment="Left" Height="23" Margin="296,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding TargetWeight}" HorizontalAlignment="Left" Height="23" Margin="487,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Age}" HorizontalAlignment="Left" Height="23" Margin="663,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="76" TextAlignment="Center" Foreground="#FF7DFFD8" FontSize="20" FontWeight="Bold"/>
        <Button Command="{Binding UpdateAccountCommand}" Content="Update stats" HorizontalAlignment="Left" Margin="75,0,0,23" VerticalAlignment="Bottom" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Button Command="{Binding DeleteAccountCommand}" Content="Delete Account" HorizontalAlignment="Left" Margin="520,0,0,23" VerticalAlignment="Bottom" FontSize="24" Height="37" Width="184" Background="Red" Foreground="White" FontFamily="Bahnschrift"/>
        <Button Command="{Binding LogOutCommand}" Content="Log Out" HorizontalAlignment="Left" Margin="296,0,0,23" VerticalAlignment="Bottom" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>

    </Grid>
</Window>
