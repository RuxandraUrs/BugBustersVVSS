<Window x:Class="FitnessApp.WpfUI.Views.CreateAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessApp.WpfUI"
        xmlns:vm="clr-namespace:FitnessApp.WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="CreateAccount" Height="850" Width="800">

    <Grid Background="#FF2D2D2D">
        <Label x:Name="UsernameLabel" Content="Username :" HorizontalAlignment="Left" Margin="223,170,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="PasswordLabel" Content="Password :" HorizontalAlignment="Left" Margin="227,220,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="EmailLabel" Content="Email :" HorizontalAlignment="Left" Margin="269,270,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="BirthdateLabel" Content="Birth Date :" HorizontalAlignment="Left" Margin="222,320,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="GenderLabel" Content="Gender :" HorizontalAlignment="Left" Margin="250,370,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="HeightLabel" Content="Height :" HorizontalAlignment="Left" Margin="258,420,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="CurrentWeightLabel" Content="Current Weight :" HorizontalAlignment="Left" Margin="174,470,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="TargetWeightLabel" Content="Target Weight :" HorizontalAlignment="Left" Margin="188,520,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <Label x:Name="TargetCalLabel" Content="Daily Calories Intake :" HorizontalAlignment="Left" Margin="119,570,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="368,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="368,222,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Email}" HorizontalAlignment="Left" Margin="368,272,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <DatePicker SelectedDate="{Binding BirthDate}" HorizontalAlignment="Left" Margin="368,322,0,0" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding Gender}" HorizontalAlignment="Left" Margin="368,372,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding HeightCm}" HorizontalAlignment="Left" Margin="368,422,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding WeightKg}" HorizontalAlignment="Left" Margin="368,472,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding TargetWeightKg}" HorizontalAlignment="Left" Margin="368,522,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <TextBox Text="{Binding DailyCalorieGoal}" HorizontalAlignment="Left" Margin="368,572,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Background="#FFA5FFE4" Height="34" FontSize="22" FontFamily="Bahnschrift"/>
        <Button Command="{Binding CreateAccountCommand}" Content="Create Account" HorizontalAlignment="Left" Margin="178,739,0,0" VerticalAlignment="Top" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Button Command="{Binding CancelCommand}" Content="Cancel" HorizontalAlignment="Left" Margin="458,739,0,0" VerticalAlignment="Top" FontSize="24" Height="37" Width="184" Background="#FF00FFB3" Foreground="White" FontFamily="Bahnschrift"/>
        <Label x:Name="Label" Content="Create your user account" HorizontalAlignment="Left" Margin="211,62,0,0" VerticalAlignment="Top" Foreground="#FF7DFFD8" FontSize="36" FontFamily="Bahnschrift" FontWeight="Bold"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="16" HorizontalAlignment="Left" Margin="141,645,0,131" Width="556"/>
    </Grid>
</Window>
